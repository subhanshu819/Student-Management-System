# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials
# Example: mongodb+srv://admin_user:secretpassword@cluster0.abcde.mongodb.net/student_management_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/student_management_db?retryWrites=true&w=majority

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
# Set a strong, random 256-bit string in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
