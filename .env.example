# Apex University Student Management System - Environment Template
# Copy this file to .env in this directory (or backend/.env) and supply your real values.
# IMPORTANT: Never commit your real .env file with production credentials to source control!

# Backend Port (default 5000)
PORT=5000

# Environment mode (development / production)
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace with your cluster credentials: mongodb+srv://<username>:<password>@cluster0.mongodb.net/student_management_db?retryWrites=true&w=majority
MONGODB_URI=

# CORS Allowed Origins (comma-separated or single domain)
CORS_ORIGIN=http://localhost:80,http://localhost:5173

# JWT Secret Key (Use a strong, cryptographically secure 64+ char random string in production)
JWT_SECRET=dev_jwt_secret_key_apex_university_2026_super_secure

# JWT Expiration Duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d
